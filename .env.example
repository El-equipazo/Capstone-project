# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# Database — fill in your local Postgres credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantumconnect
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# Secret key used to sign JWTs — generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Optional overrides
# DATABASE_URL=postgresql://user:password@host:port/dbname  # overrides the DB_* vars above
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS_ORIGINS=["http://localhost:5173"]
